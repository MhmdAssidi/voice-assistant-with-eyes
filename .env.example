# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored: never commit real keys.

DATABASE_URL=postgresql://va:va@localhost:5432/va
RTSP_URL=rtsp://localhost:8554/live
API_INTERNAL_URL=http://localhost:8000
FRAMES_DIR=../data/frames
RETENTION_MINUTES=30

# Laptop's Wi-Fi IPv4 address (ipconfig -> "Wireless LAN adapter Wi-Fi" -> IPv4 Address).
# Changes per network: update it, then run: docker compose up -d
LAN_IP=

# gemini | ollama
VLM_PROVIDER=gemini
GEMINI_API_KEY=
# Current free-tier Flash model name, set on setup day
GEMINI_MODEL=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
# "small" (downloaded automatically) or a folder that already holds the model files
WHISPER_MODEL=small
# Where downloaded models are cached. Keep it OUTSIDE OneDrive/Dropbox (they lock big files),
# e.g. C:\Users\<you>\AppData\Local\va-eyes\models
MODELS_DIR=../data/models
# true = keep each spoken question in data/questions/ (tests, B13 evaluation; only with consent)
SAVE_QUESTION_AUDIO=false
CONFIDENCE_THRESHOLD=0.25
